{"id":"ps-082","bookId":"Ps","order":82,"title":"Psalm 82 (81)","range":"82","webcRange":"82:1–8","status":"read","verseCount":8,"words":115,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.82.1","c":82,"v":1,"blocks":[{"text":"God presides in the great assembly.","style":"q1","brk":true},{"text":"He judges among the gods.","style":"q2","brk":true}],"heading":"A Psalm by Asaph."},{"ref":"Ps.82.2","c":82,"v":2,"blocks":[{"text":"“How long will you judge unjustly,","style":"q1","brk":true},{"text":"and show partiality to the wicked?” Selah.","style":"q2","brk":true}]},{"ref":"Ps.82.3","c":82,"v":3,"blocks":[{"text":"“Defend the weak, the poor, and the fatherless.","style":"q1","brk":true},{"text":"Maintain the rights of the poor and oppressed.","style":"q2","brk":true}]},{"ref":"Ps.82.4","c":82,"v":4,"blocks":[{"text":"Rescue the weak and needy.","style":"q1","brk":true},{"text":"Deliver them out of the hand of the wicked.”","style":"q2","brk":true}]},{"ref":"Ps.82.5","c":82,"v":5,"blocks":[{"text":"They don’t know, neither do they understand.","style":"q1","brk":true},{"text":"They walk back and forth in darkness.","style":"q2","brk":true},{"text":"All the foundations of the earth are shaken.","style":"q2","brk":true}]},{"ref":"Ps.82.6","c":82,"v":6,"blocks":[{"text":"I said, “You are gods,","style":"q1","brk":true},{"text":"all of you are sons of the Most High.","style":"q2","brk":true}]},{"ref":"Ps.82.7","c":82,"v":7,"blocks":[{"text":"Nevertheless you shall die like men,","style":"q1","brk":true},{"text":"and fall like one of the rulers.”","style":"q2","brk":true}]},{"ref":"Ps.82.8","c":82,"v":8,"blocks":[{"text":"Arise, God, judge the earth,","style":"q1","brk":true},{"text":"for you inherit all of the nations.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
