{"id":"ps-134","bookId":"Ps","order":134,"title":"Psalm 134 (133)","range":"134","webcRange":"134:1–3","status":"read","verseCount":3,"words":42,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.134.1","c":134,"v":1,"blocks":[{"text":"Look! Praise the LORD, all you servants of the LORD,","style":"q1","brk":true},{"text":"who stand by night in the LORD’s house!","style":"q2","brk":true}],"heading":"A Song of Ascents."},{"ref":"Ps.134.2","c":134,"v":2,"blocks":[{"text":"Lift up your hands in the sanctuary.","style":"q1","brk":true},{"text":"Praise the LORD!","style":"q2","brk":true}]},{"ref":"Ps.134.3","c":134,"v":3,"blocks":[{"text":"May the LORD bless you from Zion,","style":"q1","brk":true},{"text":"even he who made heaven and earth.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
