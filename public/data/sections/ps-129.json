{"id":"ps-129","bookId":"Ps","order":129,"title":"Psalm 129 (128)","range":"129","webcRange":"129:1–8","status":"read","verseCount":8,"words":119,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.129.1","c":129,"v":1,"blocks":[{"text":"Many times they have afflicted me from my youth up.","style":"q1","brk":true},{"text":"Let Israel now say:","style":"q2","brk":true}],"heading":"A Song of Ascents."},{"ref":"Ps.129.2","c":129,"v":2,"blocks":[{"text":"many times they have afflicted me from my youth up,","style":"q1","brk":true},{"text":"yet they have not prevailed against me.","style":"q2","brk":true}]},{"ref":"Ps.129.3","c":129,"v":3,"blocks":[{"text":"The plowers plowed on my back.","style":"q1","brk":true},{"text":"They made their furrows long.","style":"q2","brk":true}]},{"ref":"Ps.129.4","c":129,"v":4,"blocks":[{"text":"The LORD is righteous.","style":"q1","brk":true},{"text":"He has cut apart the cords of the wicked.","style":"q2","brk":true}]},{"ref":"Ps.129.5","c":129,"v":5,"blocks":[{"text":"Let them be disappointed and turned backward,","style":"q1","brk":true},{"text":"all those who hate Zion.","style":"q2","brk":true}]},{"ref":"Ps.129.6","c":129,"v":6,"blocks":[{"text":"Let them be as the grass on the housetops,","style":"q1","brk":true},{"text":"which withers before it grows up,","style":"q2","brk":true}]},{"ref":"Ps.129.7","c":129,"v":7,"blocks":[{"text":"with which the reaper doesn’t fill his hand,","style":"q1","brk":true},{"text":"nor he who binds sheaves, his bosom.","style":"q2","brk":true}]},{"ref":"Ps.129.8","c":129,"v":8,"blocks":[{"text":"Neither do those who go by say,","style":"q1","brk":true},{"text":"“The blessing of the LORD be on you.","style":"q2","brk":true},{"text":"We bless you in the LORD’s name.”","style":"q2","brk":true}]}],"folds":[],"notes":[]}
