{"id":"ps-130","bookId":"Ps","order":130,"title":"Psalm 130 (129)","range":"130","webcRange":"130:1–8","status":"read","verseCount":8,"words":105,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.130.1","c":130,"v":1,"blocks":[{"text":"Out of the depths I have cried to you, LORD.","style":"q1","brk":true}],"heading":"A Song of Ascents.","footnotes":[{"at":44,"text":"LORD or GOD in all caps is from the Hebrew יהוה Yahweh except when otherwise noted as being from the short form יה Yah."}]},{"ref":"Ps.130.2","c":130,"v":2,"blocks":[{"text":"Lord, hear my voice.","style":"q1","brk":true},{"text":"Let your ears be attentive to the voice of my petitions.","style":"q2","brk":true}]},{"ref":"Ps.130.3","c":130,"v":3,"blocks":[{"text":"If you, LORD, kept a record of sins,","style":"q1","brk":true},{"text":"Lord, who could stand?","style":"q2","brk":true}],"footnotes":[{"at":13,"text":"Hebrew: יה Yah"}]},{"ref":"Ps.130.4","c":130,"v":4,"blocks":[{"text":"But there is forgiveness with you,","style":"q1","brk":true},{"text":"therefore you are feared.","style":"q2","brk":true}]},{"ref":"Ps.130.5","c":130,"v":5,"blocks":[{"text":"I wait for the LORD.","style":"q1","brk":true},{"text":"My soul waits.","style":"q2","brk":true},{"text":"I hope in his word.","style":"q2","brk":true}]},{"ref":"Ps.130.6","c":130,"v":6,"blocks":[{"text":"My soul longs for the Lord more than watchmen long for the morning,","style":"q1","brk":true},{"text":"more than watchmen for the morning.","style":"q2","brk":true}]},{"ref":"Ps.130.7","c":130,"v":7,"blocks":[{"text":"Israel, hope in the LORD,","style":"q1","brk":true},{"text":"for there is loving kindness with the LORD.","style":"q2","brk":true},{"text":"Abundant redemption is with him.","style":"q2","brk":true}]},{"ref":"Ps.130.8","c":130,"v":8,"blocks":[{"text":"He will redeem Israel from all their sins.","style":"q1","brk":true}]}],"folds":[],"notes":[]}
