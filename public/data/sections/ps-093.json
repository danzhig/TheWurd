{"id":"ps-093","bookId":"Ps","order":93,"title":"Psalm 93 (92)","range":"93","webcRange":"93:1–5","status":"read","verseCount":5,"words":82,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.93.1","c":93,"v":1,"blocks":[{"text":"The LORD reigns!","style":"q1","brk":true},{"text":"He is clothed with majesty!","style":"q2","brk":true},{"text":"The LORD is armed with strength.","style":"q2","brk":true},{"text":"The world also is established.","style":"q1","brk":true},{"text":"It can’t be moved.","style":"q2","brk":true}]},{"ref":"Ps.93.2","c":93,"v":2,"blocks":[{"text":"Your throne is established from long ago.","style":"q1","brk":true},{"text":"You are from everlasting.","style":"q2","brk":true}]},{"ref":"Ps.93.3","c":93,"v":3,"blocks":[{"text":"The floods have lifted up, LORD,","style":"q1","brk":true},{"text":"the floods have lifted up their voice.","style":"q2","brk":true},{"text":"The floods lift up their waves.","style":"q2","brk":true}]},{"ref":"Ps.93.4","c":93,"v":4,"blocks":[{"text":"Above the voices of many waters,","style":"q1","brk":true},{"text":"the mighty breakers of the sea,","style":"q2","brk":true},{"text":"the LORD on high is mighty.","style":"q2","brk":true}]},{"ref":"Ps.93.5","c":93,"v":5,"blocks":[{"text":"Your statutes stand firm.","style":"q1","brk":true},{"text":"Holiness adorns your house,","style":"q2","brk":true},{"text":"LORD, forever more.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
