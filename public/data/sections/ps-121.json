{"id":"ps-121","bookId":"Ps","order":121,"title":"Psalm 121 (120)","range":"121","webcRange":"121:1–8","status":"read","verseCount":8,"words":110,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.121.1","c":121,"v":1,"blocks":[{"text":"I will lift up my eyes to the hills.","style":"q1","brk":true},{"text":"Where does my help come from?","style":"q2","brk":true}],"heading":"A Song of Ascents."},{"ref":"Ps.121.2","c":121,"v":2,"blocks":[{"text":"My help comes from the LORD,","style":"q1","brk":true},{"text":"who made heaven and earth.","style":"q2","brk":true}]},{"ref":"Ps.121.3","c":121,"v":3,"blocks":[{"text":"He will not allow your foot to be moved.","style":"q1","brk":true},{"text":"He who keeps you will not slumber.","style":"q2","brk":true}]},{"ref":"Ps.121.4","c":121,"v":4,"blocks":[{"text":"Behold, he who keeps Israel","style":"q1","brk":true},{"text":"will neither slumber nor sleep.","style":"q2","brk":true}]},{"ref":"Ps.121.5","c":121,"v":5,"blocks":[{"text":"The LORD is your keeper.","style":"q1","brk":true},{"text":"The LORD is your shade on your right hand.","style":"q2","brk":true}]},{"ref":"Ps.121.6","c":121,"v":6,"blocks":[{"text":"The sun will not harm you by day,","style":"q1","brk":true},{"text":"nor the moon by night.","style":"q2","brk":true}]},{"ref":"Ps.121.7","c":121,"v":7,"blocks":[{"text":"The LORD will keep you from all evil.","style":"q1","brk":true},{"text":"He will keep your soul.","style":"q2","brk":true}]},{"ref":"Ps.121.8","c":121,"v":8,"blocks":[{"text":"The LORD will keep your going out and your coming in,","style":"q1","brk":true},{"text":"from this time forward, and forever more.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
