{"id":"ps-150","bookId":"Ps","order":150,"title":"Psalm 150","range":"150","webcRange":"150:1–6","status":"read","verseCount":6,"words":79,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.150.1","c":150,"v":1,"blocks":[{"text":"Praise the LORD!","style":"q1","brk":true},{"text":"Praise God in his sanctuary!","style":"q2","brk":true},{"text":"Praise him in his heavens for his acts of power!","style":"q2","brk":true}],"footnotes":[{"at":16,"text":"Hebrew: יה Yah"}]},{"ref":"Ps.150.2","c":150,"v":2,"blocks":[{"text":"Praise him for his mighty acts!","style":"q1","brk":true},{"text":"Praise him according to his excellent greatness!","style":"q2","brk":true}]},{"ref":"Ps.150.3","c":150,"v":3,"blocks":[{"text":"Praise him with the sounding of the trumpet!","style":"q1","brk":true},{"text":"Praise him with harp and lyre!","style":"q2","brk":true}]},{"ref":"Ps.150.4","c":150,"v":4,"blocks":[{"text":"Praise him with tambourine and dancing!","style":"q1","brk":true},{"text":"Praise him with stringed instruments and flute!","style":"q2","brk":true}]},{"ref":"Ps.150.5","c":150,"v":5,"blocks":[{"text":"Praise him with loud cymbals!","style":"q1","brk":true},{"text":"Praise him with resounding cymbals!","style":"q2","brk":true}]},{"ref":"Ps.150.6","c":150,"v":6,"blocks":[{"text":"Let everything that has breath praise the LORD!","style":"q1","brk":true},{"text":"Praise the LORD!","style":"q2","brk":true}],"footnotes":[{"at":47,"text":"Hebrew: יה Yah"},{"at":64,"text":"Hebrew: יה Yah"}]}],"folds":[],"notes":[]}
