{"id":"ps-120","bookId":"Ps","order":120,"title":"Psalm 120 (119)","range":"120","webcRange":"120:1–7","status":"read","verseCount":7,"words":89,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.120.1","c":120,"v":1,"blocks":[{"text":"In my distress, I cried to the LORD.","style":"q1","brk":true},{"text":"He answered me.","style":"q2","brk":true}],"heading":"A Song of Ascents."},{"ref":"Ps.120.2","c":120,"v":2,"blocks":[{"text":"Deliver my soul, LORD, from lying lips,","style":"q1","brk":true},{"text":"from a deceitful tongue.","style":"q2","brk":true}]},{"ref":"Ps.120.3","c":120,"v":3,"blocks":[{"text":"What will be given to you, and what will be done more to you,","style":"q1","brk":true},{"text":"you deceitful tongue?","style":"q2","brk":true}]},{"ref":"Ps.120.4","c":120,"v":4,"blocks":[{"text":"Sharp arrows of the mighty,","style":"q1","brk":true},{"text":"with coals of juniper.","style":"q2","brk":true}]},{"ref":"Ps.120.5","c":120,"v":5,"blocks":[{"text":"Woe is me, that I live in Meshech,","style":"q1","brk":true},{"text":"that I dwell among the tents of Kedar!","style":"q2","brk":true}]},{"ref":"Ps.120.6","c":120,"v":6,"blocks":[{"text":"My soul has had her dwelling too long","style":"q1","brk":true},{"text":"with him who hates peace.","style":"q2","brk":true}]},{"ref":"Ps.120.7","c":120,"v":7,"blocks":[{"text":"I am for peace,","style":"q1","brk":true},{"text":"but when I speak, they are for war.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
