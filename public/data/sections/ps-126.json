{"id":"ps-126","bookId":"Ps","order":126,"title":"Psalm 126 (125)","range":"126","webcRange":"126:1–6","status":"read","verseCount":6,"words":92,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.126.1","c":126,"v":1,"blocks":[{"text":"When the LORD brought back those who returned to Zion,","style":"q1","brk":true},{"text":"we were like those who dream.","style":"q2","brk":true}],"heading":"A Song of Ascents."},{"ref":"Ps.126.2","c":126,"v":2,"blocks":[{"text":"Then our mouth was filled with laughter,","style":"q1","brk":true},{"text":"and our tongue with singing.","style":"q2","brk":true},{"text":"Then they said among the nations,","style":"q1","brk":true},{"text":"“The LORD has done great things for them.”","style":"q2","brk":true}]},{"ref":"Ps.126.3","c":126,"v":3,"blocks":[{"text":"The LORD has done great things for us,","style":"q1","brk":true},{"text":"and we are glad.","style":"q2","brk":true}]},{"ref":"Ps.126.4","c":126,"v":4,"blocks":[{"text":"Restore our fortunes again, LORD,","style":"q1","brk":true},{"text":"like the streams in the Negev.","style":"q2","brk":true}]},{"ref":"Ps.126.5","c":126,"v":5,"blocks":[{"text":"Those who sow in tears will reap in joy.","style":"q1","brk":true}]},{"ref":"Ps.126.6","c":126,"v":6,"blocks":[{"text":"He who goes out weeping, carrying seed for sowing,","style":"q2","brk":true},{"text":"will certainly come again with joy, carrying his sheaves.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
