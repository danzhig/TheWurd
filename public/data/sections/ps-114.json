{"id":"ps-114","bookId":"Ps","order":114,"title":"Psalm 114 (113)","range":"114","webcRange":"114:1–8","status":"read","verseCount":8,"words":103,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.114.1","c":114,"v":1,"blocks":[{"text":"When Israel went out of Egypt,","style":"q1","brk":true},{"text":"the house of Jacob from a people of foreign language,","style":"q2","brk":true}]},{"ref":"Ps.114.2","c":114,"v":2,"blocks":[{"text":"Judah became his sanctuary,","style":"q1","brk":true},{"text":"Israel his dominion.","style":"q2","brk":true}]},{"ref":"Ps.114.3","c":114,"v":3,"blocks":[{"text":"The sea saw it, and fled.","style":"q1","brk":true},{"text":"The Jordan was driven back.","style":"q2","brk":true}]},{"ref":"Ps.114.4","c":114,"v":4,"blocks":[{"text":"The mountains skipped like rams,","style":"q1","brk":true},{"text":"the little hills like lambs.","style":"q2","brk":true}]},{"ref":"Ps.114.5","c":114,"v":5,"blocks":[{"text":"What was it, you sea, that you fled?","style":"q1","brk":true},{"text":"You Jordan, that you turned back?","style":"q2","brk":true}]},{"ref":"Ps.114.6","c":114,"v":6,"blocks":[{"text":"You mountains, that you skipped like rams?","style":"q1","brk":true},{"text":"You little hills, like lambs?","style":"q2","brk":true}]},{"ref":"Ps.114.7","c":114,"v":7,"blocks":[{"text":"Tremble, you earth, at the presence of the Lord,","style":"q1","brk":true},{"text":"at the presence of the God of Jacob,","style":"q2","brk":true}]},{"ref":"Ps.114.8","c":114,"v":8,"blocks":[{"text":"who turned the rock into a pool of water,","style":"q1","brk":true},{"text":"the flint into a spring of waters.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
