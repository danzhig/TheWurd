{"id":"job-03","bookId":"Job","order":5,"title":"Job's First Reply","range":"40:1-5","webcRange":"40:1–5","status":"read","verseCount":5,"words":62,"minutes":1,"bookName":"Job","verses":[{"ref":"Job.40.1","c":40,"v":1,"blocks":[{"text":"Moreover the LORD answered Job,","style":"p","brk":true}]},{"ref":"Job.40.2","c":40,"v":2,"blocks":[{"text":"“Shall he who argues contend with the Almighty?","style":"q1","brk":true},{"text":"He who argues with God, let him answer it.”","style":"q2","brk":true}]},{"ref":"Job.40.3","c":40,"v":3,"blocks":[{"text":"Then Job answered the LORD,","style":"p","brk":true}]},{"ref":"Job.40.4","c":40,"v":4,"blocks":[{"text":"“Behold, I am of small account. What will I answer you?","style":"q1","brk":true},{"text":"I lay my hand on my mouth.","style":"q2","brk":true}]},{"ref":"Job.40.5","c":40,"v":5,"blocks":[{"text":"I have spoken once, and I will not answer;","style":"q1","brk":true},{"text":"Yes, twice, but I will proceed no further.”","style":"q2","brk":true}]}],"folds":[],"notes":[]}
