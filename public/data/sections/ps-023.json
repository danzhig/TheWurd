{"id":"ps-023","bookId":"Ps","order":23,"title":"Psalm 23 (22)","range":"23","webcRange":"23:1–6","status":"read","verseCount":6,"words":114,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.23.1","c":23,"v":1,"blocks":[{"text":"The LORD is my shepherd;","style":"q1","brk":true},{"text":"I shall lack nothing.","style":"q2","brk":true}],"heading":"A Psalm by David."},{"ref":"Ps.23.2","c":23,"v":2,"blocks":[{"text":"He makes me lie down in green pastures.","style":"q1","brk":true},{"text":"He leads me beside still waters.","style":"q2","brk":true}]},{"ref":"Ps.23.3","c":23,"v":3,"blocks":[{"text":"He restores my soul.","style":"q1","brk":true},{"text":"He guides me in the paths of righteousness for his name’s sake.","style":"q2","brk":true}]},{"ref":"Ps.23.4","c":23,"v":4,"blocks":[{"text":"Even though I walk through the valley of the shadow of death,","style":"q1","brk":true},{"text":"I will fear no evil, for you are with me.","style":"q2","brk":true},{"text":"Your rod and your staff,","style":"q1","brk":true},{"text":"they comfort me.","style":"q2","brk":true}]},{"ref":"Ps.23.5","c":23,"v":5,"blocks":[{"text":"You prepare a table before me","style":"q1","brk":true},{"text":"in the presence of my enemies.","style":"q2","brk":true},{"text":"You anoint my head with oil.","style":"q1","brk":true},{"text":"My cup runs over.","style":"q2","brk":true}]},{"ref":"Ps.23.6","c":23,"v":6,"blocks":[{"text":"Surely goodness and loving kindness shall follow me all the days of my life,","style":"q1","brk":true},{"text":"and I will dwell in the LORD’s house forever.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
