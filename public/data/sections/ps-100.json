{"id":"ps-100","bookId":"Ps","order":100,"title":"Psalm 100 (99)","range":"100","webcRange":"100:1–5","status":"read","verseCount":5,"words":83,"minutes":1,"bookName":"Psalms","verses":[{"ref":"Ps.100.1","c":100,"v":1,"blocks":[{"text":"Shout for joy to the LORD, all you lands!","style":"q1","brk":true}],"heading":"A Psalm of thanksgiving."},{"ref":"Ps.100.2","c":100,"v":2,"blocks":[{"text":"Serve the LORD with gladness.","style":"q2","brk":true},{"text":"Come before his presence with singing.","style":"q2","brk":true}]},{"ref":"Ps.100.3","c":100,"v":3,"blocks":[{"text":"Know that the LORD, he is God.","style":"q1","brk":true},{"text":"It is he who has made us, and we are his.","style":"q2","brk":true},{"text":"We are his people, and the sheep of his pasture.","style":"q2","brk":true}]},{"ref":"Ps.100.4","c":100,"v":4,"blocks":[{"text":"Enter into his gates with thanksgiving,","style":"q1","brk":true},{"text":"and into his courts with praise.","style":"q2","brk":true},{"text":"Give thanks to him, and bless his name.","style":"q2","brk":true}]},{"ref":"Ps.100.5","c":100,"v":5,"blocks":[{"text":"For the LORD is good.","style":"q1","brk":true},{"text":"His loving kindness endures forever,","style":"q2","brk":true},{"text":"his faithfulness to all generations.","style":"q2","brk":true}]}],"folds":[],"notes":[]}
